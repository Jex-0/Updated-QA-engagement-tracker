{
  "name": "client-engagement-tracker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Enterprise Client Engagement Tracker — agent QA checklist, team leader dashboard, manager console, disputes and audit logging.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port ${PORT:-5173}",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
